# LLM (OpenAI-compatible API)
LLM_API_KEY=replace_with_your_api_key
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Per-task limits; duration is checked at node/LLM boundaries. Cost enforcement
# needs non-zero provider prices below.
TASK_MAX_LLM_CALLS=16
TASK_MAX_CONTEXT_CHARS=200000
TASK_MAX_TOTAL_TOKENS=100000
TASK_MAX_DURATION_SECONDS=300
TASK_MAX_ESTIMATED_COST_USD=1
# USD per one million tokens; 0 means cost is reported as unavailable/zero.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
MAX_CONCURRENT_QUERIES=4
MAX_QUEUED_TASKS=20
API_AUTH_ENABLED=false
# Explicitly bypass authentication only for a trusted, single-user local run.
LOCAL_ACCESS_ENABLED=false
# Comma-separated secrets. Required only when API_AUTH_ENABLED=true.
API_KEYS=
# Preferred identity-aware format, for example:
# [{"id":"analyst-a","role":"analyst","key":"replace-me"},{"id":"admin","role":"admin","key":"replace-me-too"}]
API_PRINCIPALS_JSON=
# Browser login. Change the bootstrap password before any shared deployment.
WEB_LOGIN_ENABLED=true
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin123!
# Shared per-tenant budget across POST /query and POST /tasks. Set requests=0 to disable.
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
TASK_DB_PATH=./data/runtime/tasks.db
TASK_EVENT_POLL_SECONDS=0.25
TASK_STALE_SECONDS=300
CLARIFICATION_TTL_SECONDS=1800
TASK_RETENTION_SECONDS=604800
TASK_MAX_RECORDS=1000
AUDIT_RETENTION_SECONDS=2592000
AUDIT_MAX_RECORDS=10000
# embedded: API process executes tasks; external: separate task_worker process.
TASK_EXECUTION_MODE=embedded
TASK_WORKER_POLL_SECONDS=0.5
TASK_WORKER_LEASE_SECONDS=60
TASK_WORKER_MAX_ATTEMPTS=2

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=analytics_dev_password
MYSQL_DATABASE=ai_analytics
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_POOL_TIMEOUT_SECONDS=10
SQL_EXECUTION_TIMEOUT_MS=60000
SQL_MAX_RESULT_ROWS=1000
SQL_ALLOWED_TABLES=customers,orders,monthly_revenue,product_summary,support_agents,support_tickets
# Docker Compose separates the root initializer from the SELECT-only API user.
MYSQL_ROOT_PASSWORD=analytics_dev_password
MYSQL_APP_USER=analytics_reader
MYSQL_APP_PASSWORD=analytics_read_password

# Vector store and embedding model
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=BAAI/bge-small-zh

# Feature switches
BUSINESS_SEMANTICS_ENABLED=true
ANALYSIS_MEMORY_ENABLED=true
# Explicit offline defense scenarios built from a fixed local dataset snapshot.
DEMO_MODE_ENABLED=true
